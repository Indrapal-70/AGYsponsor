{
  "agentsponsor-pre-invocation": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/statusline.js PreInvocation",
        "timeout": 5
      }
    ]
  },
  "agentsponsor-post-invocation": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "node scripts/statusline.js PostInvocation",
        "timeout": 5
      }
    ]
  },
  "agentsponsor-pre-tool-use": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/statusline.js PreToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "agentsponsor-post-tool-use": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/statusline.js PostToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "agentsponsor-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/statusline.js Stop",
        "timeout": 5
      }
    ]
  }
}
