# AgentSponsor Production MVP Environment Variables

# Supabase Configuration (Required for Production Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AgentSponsor Public API URL (Used by CLI Plugin and Client SDK)
# Local: http://localhost:8000 (FastAPI) or http://localhost:3000 (Next.js API)
# Production: https://api.agentsponsor.com or https://agentsponsor.com
AGENTSPONSOR_API_URL=http://localhost:3000

# Exposure HMAC Token Secret (Used for server-signing and verifying impression tokens)
EXPOSURE_TOKEN_SECRET=replace_with_a_secure_random_64_char_hex_secret

# Payment Provider Configuration (India-compatible: MOCK or RAZORPAY)
PAYMENT_PROVIDER=MOCK
PAYMENT_PUBLIC_KEY=rzp_test_your_key_id
PAYMENT_SECRET_KEY=your_razorpay_secret_key
PAYMENT_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Payout Provider Configuration (UPI / Bank Transfer)
PAYOUT_PROVIDER=MOCK
PAYOUT_PUBLIC_KEY=pout_key_placeholder
PAYOUT_SECRET_KEY=pout_secret_placeholder
PAYOUT_WEBHOOK_SECRET=pout_webhook_placeholder

# Initial Admin Configuration
ADMIN_EMAIL=owner@agentsponsor.com
ADMIN_SECRET=replace_with_strong_admin_secret_key
